# Obtain Sandbox API credentials at https://developer.paypal.com/dashboard/applications/sandbox
# NEVER commit the real .env file or a secret to a public repository.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: OpenAI-compatible LLM for more fluent agent explanations.
# Without an API key, a local TF-IDF machine-learning recommender still works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
